POSTGRES_USER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mydb
POSTGRES_APP_USER=appuser

# Change here
POSTGRES_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me
PROJECT_NAME=g16 # Need to be unique
FRONTEND_PORT=6016 # Need to be unique
BACKEND_IMAGE_NAME=xielnwza/preflight-backend:latest
FRONTEND_IMAGE_NAME=xielnwza/preflight-frontend:latest
