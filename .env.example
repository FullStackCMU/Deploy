# Public address of this deployment (no trailing slash). Used for CORS, the login redirect,
# and the OAuth callback ${PUBLIC_URL}/api/auth/callback, which must be registered with the OAuth provider.
PUBLIC_URL=https://fsg16.cpecmu.com

# CPE mock OAuth (ask the team)
OAUTH_CLIENT_ID=ask-the-team
OAUTH_CLIENT_SECRET=ask-the-team
OAUTH_AUTHORIZE_URL=https://oauth497.cpecmu.com/application/o/authorize/
OAUTH_TOKEN_URL=https://oauth497.cpecmu.com/application/o/token/

# AI comment check (deepseek | none)
AI_PROVIDER=none
DEEPSEEK_API_KEY=
